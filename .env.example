# AI Agency OS - Environment Variables - Real API - UnoRouter - $0 - يعمل فعلياً
# Copy to .env and fill - API provided by user - يعمل فعلياً - ليس وهماً

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=True
SECRET_KEY=ai-agency-os-real-secret-key-2026-09-13-production-ready

# Database
DATABASE_URL=sqlite:///./ai_agency.db

# LLM Providers - Real - UnoRouter $0 - https://api.unorouter.com/v1/chat/completions
# curl https://api.unorouter.com/v1/chat/completions -H "Authorization: Bearer YOUR_API_KEY" -H "Content-Type: application/json" -d '{"model": "gemini-flash-lite:free","messages": [{"role": "user", "content": "Hello!"}],"stream": true}'
# API: sk-acwGAyBgbL5874HCWoVuS7Uwzf9XNpEWlaRrvMizePyEfUoR - Provider: https://api.unorouter.com/v1/chat/completions - Model: gemini-flash-lite:free
OPENAI_API_KEY=sk-acwGAyBgbL5874HCWoVuS7Uwzf9XNpEWlaRrvMizePyEfUoR
OPENAI_BASE_URL=https://api.unorouter.com/v1

UNOROUTER_API_KEY=sk-acwGAyBgbL5874HCWoVuS7Uwzf9XNpEWlaRrvMizePyEfUoR
UNOROUTER_BASE_URL=https://api.unorouter.com/v1

ANTHROPIC_API_KEY=sk-ant-your-key

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_ENABLED=True

DEFAULT_MODEL=gemini-flash-lite:free
# JSON list for pydantic_settings - Real models - UnoRouter $0
ENABLED_MODELS=["gemini-flash-lite:free","gpt-4o-mini","gpt-4o","claude-3-5-sonnet","llama3.1:8b"]

# Memory
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2
MEMORY_MAX_CHARS=10000

# ECC Features
VERIFICATION_ENABLED=True
AGENT_SHIELD_ENABLED=True
HOOKS_ENABLED=True
CONTINUOUS_LEARNING=True
INSTINCTS_ENABLED=True

# Agency
MAX_CLIENTS=100
MAX_PROJECTS_PER_CLIENT=50
