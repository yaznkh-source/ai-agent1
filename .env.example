# AI Agency OS - Environment Variables
# Copy to .env and fill

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=True
SECRET_KEY=change-this-to-random-secret-in-production

# Database
DATABASE_URL=sqlite:///./ai_agency.db

# LLM Providers - Open WebUI style multi-provider
OPENAI_API_KEY=sk-your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=sk-ant-your-key

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_ENABLED=True

DEFAULT_MODEL=gpt-4o-mini
# Comma-separated list
ENABLED_MODELS=gpt-4o-mini,gpt-4o,claude-3-5-sonnet,llama3.1:8b

# Memory
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2
MEMORY_MAX_CHARS=10000

# ECC Features
VERIFICATION_ENABLED=True
AGENT_SHIELD_ENABLED=True
HOOKS_ENABLED=True
CONTINUOUS_LEARNING=True
INSTINCTS_ENABLED=True

# Agency
MAX_CLIENTS=100
MAX_PROJECTS_PER_CLIENT=50
