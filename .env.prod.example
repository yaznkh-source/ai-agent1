# Production Environment - AI Agency OS v9
# Copy to .env.prod and fill real values

# Database
POSTGRES_PASSWORD=change-this-to-strong-password-123
DATABASE_URL=postgresql://aiagency:${POSTGRES_PASSWORD}@postgres:5432/aiagency

# Redis
REDIS_PASSWORD=change-this-redis-password
REDIS_URL=redis://:change-this-redis-password@redis:6379/0

# JWT
JWT_SECRET=change-this-to-super-secret-jwt-key-min-32-chars-long

# LLM
OPENAI_API_KEY=sk-...
OLLAMA_HOST=http://ollama:11434

# Storage - S3 or MinIO
STORAGE_PROVIDER=s3
S3_BUCKET=ai-agency-prod
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
# For MinIO local S3
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-minio-password

# Email - SendGrid or SMTP
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=SG....
FROM_EMAIL=noreply@ai-agency.os
# Or SMTP
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG....

# Billing - Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

# Monitoring
GRAFANA_PASSWORD=change-grafana-password

# White-label / Branding
BRAND_NAME=AI Agency OS
BRAND_LOGO=https://ai-agency.os/logo.png
BRAND_PRIMARY_COLOR=#8b5cf6
BRAND_DOMAIN=ai-agency.os
WHITE_LABEL_ENABLED=false

# Env
ENV=production
HOST=0.0.0.0
PORT=8000

# Frontend
VITE_API_URL=https://api.ai-agency.os
VITE_BRAND_NAME=AI Agency OS
VITE_WS_URL=wss://api.ai-agency.os
