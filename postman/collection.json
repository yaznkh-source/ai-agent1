{
  "info": {
    "name": "AI Agency OS - 68 Agents, 292 Skills - API Collection",
    "description": "Full API collection for AI Agency OS v12 - 19 routers, 80+ endpoints, 68 agents, 292 skills, Enterprise Ready\n\nBase URL: http://localhost:8000 or https://api.ai-agency.os\n\nAuth: Bearer JWT or API key\n\nDocs: http://localhost:8000/api/docs\n\nFeatures: Agents 68, Skills 292, Chat, Memory, Tools 9, Functions Pipe/Filter/Action/Event, Pipelines 4 + Builder, Agency Projects/Clients/Tasks, Knowledge RAG 5 collections, Verification real, Auth JWT/RBAC, Billing Stripe $0/$49/$199/$999, Eval, Integrations Slack/GitHub/Stripe/SendGrid/S3, Marketplace, Realtime WS, Storage S3/local, Email SendGrid/SMTP, Audit SOC2/GDPR, Teams RBAC + White-label, Zapier/Make/HubSpot/Slack 5000+ apps",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Root",
      "item": [
        { "name": "Get Features - 68 Agents 292 Skills", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/", "host": ["{{baseUrl}}"], "path": [""] } } },
